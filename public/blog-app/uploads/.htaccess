# Serve uploads as inert files. Even if something that looks like a script is
# written here, it must never be handed to an interpreter.
#
# Note: no php_flag/php_value directives. Under PHP-FPM — HostGator's default
# handler — those are unrecognised and Apache answers every request in this
# directory with a 500. RemoveHandler plus an explicit deny achieves the same
# thing and is safe on every handler.
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .phps
  RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .phps
</IfModule>
<FilesMatch "\.(php|phtml|phar|php[0-9]|phps|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
