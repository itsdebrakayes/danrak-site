# ---------------------------------------------------------------------------
# Danrak Productions — Apache production config
# ---------------------------------------------------------------------------

# --- MIME types (older Apache builds don't know these) ---------------------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType video/mp4                  .mp4
  AddType application/json           .json
  AddType application/xml            .xml
  AddType text/plain                 .txt
  AddType application/manifest+json  .webmanifest
</IfModule>

# --- Compression -----------------------------------------------------------
# Text assets only. Images/video are already compressed; re-compressing them
# burns CPU for nothing.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------------
# Vite fingerprints filenames (index-a1b2c3.js), so hashed assets can be cached
# forever. HTML must never be cached or visitors get a stale app shell that
# points at deleted asset hashes.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/avif            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType video/mp4             "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted build output: immutable for a year.
  <FilesMatch "\.(js|css|woff2|webp|avif|png|jpe?g|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The app shell and crawler files must always revalidate.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- SPA routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite crawler files. Without this, a missing sitemap.xml silently
  # falls through to index.html and search engines are served HTML for XML.
  RewriteRule ^(robots\.txt|sitemap\.xml|llms\.txt|favicon\.ico)$ - [L]

  RewriteRule ^index\.html$ - [L]

  # Real files and directories are served as-is (this is what serves the
  # prerendered per-route index.html files).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# --- Don't serve source maps or dotfiles in production ---------------------
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
